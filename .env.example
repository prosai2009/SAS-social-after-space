# SAS backend configuration.
# Copy this file to ".env" and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
#   Project URL      -> VITE_SUPABASE_URL
#   anon public key  -> VITE_SUPABASE_ANON_KEY
#
# IMPORTANT: only ever put the PUBLIC "anon" key here. It is safe for the
# frontend because all privacy is enforced by Row Level Security in
# supabase/schema.sql. NEVER put the service_role key in this file.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
